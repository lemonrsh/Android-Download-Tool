{
  "manifest_version": 2,
  "name": "Fetchly Integration",
  "version": "0.2.0",
  "description": "Sends downloads, videos and audio from Firefox to the Fetchly Android app.",
  "browser_specific_settings": {
    "gecko": { "id": "fetchly@example.invalid", "strict_min_version": "113.0" },
    "gecko_android": { "strict_min_version": "113.0" }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "cookies",
    "tabs",
    "<all_urls>"
  ],
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_title": "Fetchly: media on this page",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
